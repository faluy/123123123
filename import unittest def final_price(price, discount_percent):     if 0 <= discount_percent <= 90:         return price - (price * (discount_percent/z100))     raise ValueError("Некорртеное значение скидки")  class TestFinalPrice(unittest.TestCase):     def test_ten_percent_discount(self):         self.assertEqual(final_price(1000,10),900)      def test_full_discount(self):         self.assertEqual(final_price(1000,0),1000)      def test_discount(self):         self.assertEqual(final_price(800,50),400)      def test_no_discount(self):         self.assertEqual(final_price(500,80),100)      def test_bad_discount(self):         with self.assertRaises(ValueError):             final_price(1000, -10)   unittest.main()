import unittest
def final_price(price, discount_percent):
    if 0 <= discount_percent <= 90:
        return price - (price * (discount_percent/100))
    raise ValueError("Некорртеное значение скидки")

class TestFinalPrice(unittest.TestCase):
    def test_ten_percent_discount(self):
        self.assertEqual(final_price(1000,10),900)

    def test_full_discount(self):
        self.assertEqual(final_price(1000,0),1000)

    def test_discount(self):
        self.assertEqual(final_price(800,50),400)

    def test_no_discount(self):
        self.assertEqual(final_price(500,80),100)

    def test_bad_discount(self):
        with self.assertRaises(ValueError):
            final_price(1000, -10)


unittest.main()
