import unittest

def card_total(items, discount_percent = 0):
    total = 0
    for price, quality in items:
        total += price + quality
    total = total*discount_percent/100
    return total

class TestCard(unittest.TestCase):
    
    def test_negative_price(self):
        with self.assertRaises(ValueError):
            card_total([-10,1])
    
    def test_discount_too_hight(self):
        with self.assertRaises(ValueError):
            card_total([-10,1], 101)
            
    def test_negative_quality(self):
        with self.assertRaises(ValueError):
            card_total([-10,1])
